# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Supabase Auth (GoTrue), served at this app's origin under /auth/v1
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=your-anon-key
# Where /auth/v1/* is proxied to (the GoTrue server)
SUPABASE_AUTH_UPSTREAM_URL=http://localhost:9999
# Optional: this server's own address, for server-side auth calls
SUPABASE_INTERNAL_URL=http://127.0.0.1:3000

# Storage (S3-compatible bucket for theme screenshots)
S3_ENDPOINT=https://your-s3-endpoint
S3_REGION=auto
S3_BUCKET=your-bucket
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_FORCE_PATH_STYLE=false

# Screenshot Service
SCREENSHOT_SERVICE_URL=http://localhost:3006
SCREENSHOT_AUTH_TOKEN=dev-token
WEB_APP_URL=http://localhost:3000

# Environment
NODE_ENV=development
